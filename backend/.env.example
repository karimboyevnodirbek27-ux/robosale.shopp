# Server
PORT=5000
NODE_ENV=development
BACKEND_URL=http://localhost:5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/robosale_db

# JWT (production'da kuchli, tasodifiy qiymat qo'ying)
JWT_SECRET=change-this-to-a-long-random-string

# CORS (vergul bilan ajratilgan domenlar)
CORS_ORIGIN=http://localhost:5173,http://localhost:7878

# Admin (faqat npm run seed:admin uchun ishlatiladi)
ADMIN_NAME=RoboSale Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=+998900000000
ADMIN_PASSWORD=change-this-password

# Telegram (yangi buyurtma xabarlari uchun, ixtiyoriy)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# Cloudinary (rasmlarni saqlash uchun, ixtiyoriy)
# Bo'sh bo'lsa, rasmlar backend/uploads papkasiga saqlanadi (lokal rejim).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
